# Copiá a .env (ese archivo no se commitea).

PORT=3101
CORS_ORIGIN=http://localhost:3100
FIREBASE_PROJECT_ID=diccionario-multidisciplina

# --- Solo local (emulators) ---
# Si estas dos están, Nest NO usa la cuenta de servicio.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Solo producción (Railway, etc.) ---
# No las pongas en .env local. El JSON entero en UNA línea / una env.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# CORS_ORIGIN=https://tu-app.vercel.app
# Sin FIRESTORE_EMULATOR_HOST ni FIREBASE_AUTH_EMULATOR_HOST
