# Copiá a .env.local (ese archivo no se commitea).

# Nest (server components usan API_URL; el browser usa NEXT_PUBLIC_*)
API_URL=http://localhost:3101
NEXT_PUBLIC_API_URL=http://localhost:3101

# --- Solo local (Auth emulator) ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-diccionario
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=diccionario-multidisciplina
NEXT_PUBLIC_FIREBASE_APP_ID=demo
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Solo producción (Vercel) ---
# API_URL y NEXT_PUBLIC_API_URL = https://tu-api.up.railway.app
# NEXT_PUBLIC_FIREBASE_* = valores reales de Firebase Console (app web)
# NO definas NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST: si está, el login
# habla con 9099 en vez de Auth de Google.
